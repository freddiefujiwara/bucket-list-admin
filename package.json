{
  "name": "bucket-list",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "vite build --outDir dist-staging",
    "preview": "vite preview",
    "test": "vitest run",
    "test:staging": "playwright test e2e/staging.check.js",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "gh-pages": "^6.2.0",
    "jsdom": "^31.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
